# La API de un cliente: despliegue/clientes/<cliente>/api.env. Lo arma solo
# scripts/alta-cliente.sh, con contraseñas nuevas; este archivo muestra qué lleva.
# Variables explicadas en apps/base-backend/.env.example.
NODE_ENV=production
PORT=3000
# Usuario de permisos mínimos (<cliente>_app): lee y escribe, pero no cambia tablas ni borra
# la bitácora. Host `postgres`: el de despliegue/compose.yml.
DATABASE_URL=postgresql://cliente1_app:CONTRASENA@postgres:5432/cliente1
REDIS_URL=redis://:CONTRASENA_REDIS@redis:6379
# Su subdominio, con https.
CORS_ORIGINS=https://cliente1.midominio.com
# Detrás de Nginx: para ver la IP real del usuario.
TRUST_PROXY=true
LOG_LEVEL=info
ZONA_NEGOCIO=America/Guayaquil
# Uno distinto por cliente: openssl rand -base64 64 | tr -d '\n'
JWT_SECRETO=
SESION_DURACION_MAXIMA_HORAS=13
SESION_INACTIVIDAD_MINUTOS=120
LIMITE_LOGIN_POR_MINUTO=10
LIMITE_USUARIO_POR_MINUTO=300
LIMITE_IP_POR_MINUTO=60
# Las de admin:crear-inicial (EMPRESA_INICIAL_NOMBRE, ADMIN_INICIAL_*) no van aquí: el script
# de alta se las pasa al comando solo mientras corre (la contraseña no queda en ningún archivo).
