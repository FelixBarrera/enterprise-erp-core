# despliegue/.env en el servidor (nunca se sube al repositorio). Lo arma solo
# scripts/iniciar-servidor.sh; este archivo muestra qué lleva.
# Contraseñas de los servicios comunes, al azar: openssl rand -base64 32 | tr -d '/+='
POSTGRES_USUARIO=postgres
POSTGRES_CONTRASENA=
REDIS_CONTRASENA=
# Zona de la hora en los mensajes de PostgreSQL (la del negocio la fija cada cliente en su .env).
ZONA_NEGOCIO=America/Guayaquil
# Versión de las imágenes que se usa (por defecto: latest, la última construida en el servidor).
VERSION=latest
# Puertos de Nginx en el servidor (por defecto 80 y 443; otros solo para probar en una PC).
PUERTO_HTTP=80
PUERTO_HTTPS=443
# Dominio de los clientes: cada uno entra por <cliente>.<DOMINIO_BASE>.
DOMINIO_BASE=midominio.com
# Correo para Let's Encrypt (avisa si un certificado está por vencer).
CORREO_CERTIFICADOS=
# Cuántos días se guardan los respaldos en el servidor (scripts/respaldar.sh).
DIAS_RESPALDO=30
