# Copiar a apps/base-backend/.env y ajustar. El backend no arranca si falta algo
# (se valida en src/shared/infrastructure/config/environment-variables.ts).
# Variable nueva → esa clase, este archivo y el env: del CI (.github/workflows/backend.yml).

# development | test | production (por defecto: development)
NODE_ENV=development
# Puerto de la API (por defecto: 3000)
PORT=3000
# PostgreSQL de docker-compose (puerto 5433 en esta PC)
DATABASE_URL=postgresql://base_erp:base_erp_local@localhost:5433/base_erp?schema=public
# Redis de docker-compose (puerto 6380 en esta PC)
REDIS_URL=redis://localhost:6380
# Sitios web que pueden llamar a la API desde el navegador (CORS), separados por coma.
# En desarrollo, el frontend de Angular.
CORS_ORIGINS=http://localhost:4200
# true solo si la API está detrás de Nginx (para leer la IP real del usuario). Por defecto: false
TRUST_PROXY=false
# Cuánto se escribe en el log: fatal | error | warn | info | debug | trace | silent (por defecto: info).
# En desarrollo se ve legible, en producción una línea JSON por evento. Los e2e usan silent.
LOG_LEVEL=info
# Zona horaria del negocio (regla 11): de ella salen la hora y "qué día es", esté donde esté
# el servidor. Nombre exacto de la lista IANA (America/Guayaquil, America/Lima, Europe/Madrid…);
# nunca -05:00 ni EST. Por defecto: America/Guayaquil.
# OJO: se elige al instalar y NO se cambia con datos guardados (las fechas ya calculadas no se
# recalculan). Para la zona de la base, ver docs/manual-docker.md.
ZONA_NEGOCIO=America/Guayaquil

# ─── Sesión ───
# Firma de los access token. OBLIGATORIA, al azar y de al menos 64 caracteres, una distinta por
# instalación (nunca la de otra PC). Generarla con: openssl rand -base64 64
JWT_SECRETO=
# Lo más que dura una sesión, aunque se use sin parar, en horas (1 a 24; por defecto: 13).
SESION_DURACION_MAXIMA_HORAS=13
# Sin usar el sistema este tiempo, la sesión se corta, en minutos (15 a 720; por defecto: 120).
SESION_INACTIVIDAD_MINUTOS=120

# ─── Límite de peticiones por minuto (se guarda en Redis; si Redis cae, se deja pasar) ───
# Intentos de login por IP (por defecto: 10).
LIMITE_LOGIN_POR_MINUTO=10
# Peticiones de un usuario con sesión, sumando todos sus equipos (por defecto: 300).
LIMITE_USUARIO_POR_MINUTO=300
# Peticiones sin sesión (login, refresh) por IP (por defecto: 60). Si toda la oficina sale a
# internet por una sola IP, comparte este cupo y el del login: subirlos.
LIMITE_IP_POR_MINUTO=60

# ─── Solo para `pnpm admin:crear-inicial` (la API no las usa; pueden quedar vacías) ───
# La primera empresa y su primer administrador. La contraseña es TEMPORAL: se cambia la primera
# vez que entra. Reglas: de 8 a 128 caracteres, no común ni trivial, sin el usuario ni la empresa.
# Después de correr el comando, BORRAR ADMIN_INICIAL_CONTRASENA de este archivo.
EMPRESA_INICIAL_NOMBRE=
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_NOMBRE=
ADMIN_INICIAL_CONTRASENA=
